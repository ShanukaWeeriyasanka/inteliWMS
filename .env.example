# LLM Configuration
LLM_PRIMARY=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_URL=http://localhost:11434

# Database
# DEV (no install needed): SQLite local file
DATABASE_URL=sqlite:///./intelliwms.db
# PROD (Docker/PostgreSQL):
# DATABASE_URL=postgresql://intelliwms_user:intelliwms_pass@localhost:5432/intelliwms

# JWT & Security
JWT_SECRET=your-secret-key-minimum-32-characters-long

# Logging
LOG_LEVEL=INFO
