# LLM Configuration
LLM_PRIMARY=gemini
GEMINI_API_KEY=your_gemini_api_key_here
FULFILLMENT_GEMINI_API_KEY=your_fulfillment_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_URL=http://localhost:11434

# Agent Model Selection
KNOWLEDGE_AGENT_MODEL=gemini/gemini-2.5-flash

# Database
# Shared Cloud PostgreSQL (Supabase / Neon):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Local fallback:
DATABASE_URL=sqlite:///./intelliwms.db

# Warehouse Digital Twin (map behind the chat; needs PostgreSQL)
# Docker: uses the postgres DATABASE_URL automatically. Local SQLite dev: point
# this at any PostgreSQL (e.g. the docker one on localhost:5432) to enable the map.
# TWIN_DATABASE_URL=postgresql://intelliwms_user:intelliwms_pass@localhost:5432/intelliwms
# Supabase session pooler (port 5432 supports the map's LISTEN connection):
# TWIN_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
TWIN_DB_SCHEMA=twin
TWIN_AUTO_SETUP=true

# Subscription plans (Starter / Professional / Enterprise)
# There is no payment gateway, so upgrading from "Pricing & Plans" only works in demo mode
# (APP_ENV=development + DEMO_PLAN_SWITCH_ENABLED=true), and only for the accounts / roles listed.
# Without these lines every upgrade is refused with 403. Downgrades always work.
# University demo only: on a real deployment set APP_ENV=production and remove the DEMO_ lines.
APP_ENV=development
DEMO_PLAN_SWITCH_ENABLED=true
DEMO_PLAN_SWITCH_USERS=john_staff,sarah_manager,admin_user
DEMO_PLAN_SWITCH_ROLES=admin

# JWT & Security
JWT_SECRET=your-secret-key-minimum-32-characters-long

# Logging
LOG_LEVEL=INFO
# Per-logger levels, e.g. mcp=WARNING,agents.inventory_agent=DEBUG
LOG_LEVELS=mcp=WARNING,httpx=WARNING
# Message / answer / tool-argument text is left out of logs unless this is true
LOG_INCLUDE_CONTENT=false
LOG_MAX_FIELD_LEN=500

# Metrics (GET /metrics, Prometheus text). Set METRICS_TOKEN to require "Authorization: Bearer <token>"
METRICS_ENABLED=true
METRICS_TOKEN=

# Upper bound (seconds) for one coordinator LLM call (rewrite / classify / small-talk reply)
LLM_TIMEOUT_S=8

# Chat threads (saved conversations)
CHAT_HISTORY_CONTEXT_TURNS=6
CHAT_MAX_MESSAGE_CHARS=4000

# --- Inventory MCP server ------------------------------------------------------
# memory          = the inventory MCP server runs inside the backend (real MCP protocol, no extra process)
# streamable_http = connect to a standalone server: python -m mcp_servers.inventory_mcp_server
INVENTORY_MCP_TRANSPORT=memory
# Required for streamable_http (e.g. http://127.0.0.1:8003/mcp); the server needs the same token
INVENTORY_MCP_URL=
INVENTORY_MCP_TOKEN=
INVENTORY_MCP_TIMEOUT_S=5
INVENTORY_MCP_MAX_RETRIES=2
INVENTORY_MCP_RETRY_BACKOFF_S=0.2
# Standalone server only: Host headers it accepts (DNS-rebinding protection)
INVENTORY_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# Curated anomaly scenarios for demos; always labelled "Demo scenario" when on
INVENTORY_DEMO_DATA=false
# Whole inventory request budget (seconds)
INVENTORY_TIMEOUT_SEC=15
# Optional age limit for recorded inventory balances. 0 reports timestamps without declaring staleness.
INVENTORY_STOCK_MAX_AGE_SECONDS=0

# --- Knowledge Agent Service -------------------------------------------------
KNOWLEDGE_SERVER_HOST=0.0.0.0
KNOWLEDGE_SERVER_PORT=8002
KNOWLEDGE_SERVICE_VERSION=1.1.0

# CORS: comma-separated origins (use * to allow all -- not recommended in prod)
KNOWLEDGE_CORS_ORIGINS=*

# ChromaDB vector store
CHROMA_PERSIST_DIR=data/chroma_db
KNOWLEDGE_COLLECTION_NAME=warehouse_knowledge
KNOWLEDGE_RAG_TOP_K=2
KNOWLEDGE_MIN_CHUNK_LEN=30

# Ontology path
ONTOLOGY_PATH=data/warehouse_ontology.json

# Location search
KNOWLEDGE_LOC_SEARCH_LIMIT=5

# Compliance rule overrides (SOP-STG-002 / SOP-SAF-003)
COMPLIANCE_STACK_ZONE_A=3
COMPLIANCE_STACK_ZONE_C=2
COMPLIANCE_STACK_DEFAULT=3
COMPLIANCE_SPEED_AISLE=5
COMPLIANCE_SPEED_CORRIDOR=8
COMPLIANCE_SPEED_CROSSDOCK=8
COMPLIANCE_DEFAULT_TIERS=4
COMPLIANCE_DEFAULT_SPEED=6
